{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"security": {
			"csp": null
		},
		"windows": [
			{
				"decorations": true,
				"height": 720,
				"hiddenTitle": true,
				"minHeight": 600,
				"minWidth": 840,
				"theme": "Light",
				"title": "Theoria",
				"titleBarStyle": "Overlay",
				"trafficLightPosition": {
					"x": 14,
					"y": 20
				},
				"width": 1120
			}
		]
	},
	"build": {
		"beforeBuildCommand": "pnpm build",
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"targets": "all"
	},
	"identifier": "com.agentgauge.desktop",
	"productName": "Theoria",
	"version": "0.1.0"
}
