{
	"name": "agent-gauge",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@11.10.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm typecheck && vite build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome lint .",
		"lint:staged": "lint-staged",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
		"prepare": "husky",
		"tauri": "tauri"
	},
	"dependencies": {
		"@gravity-ui/icons": "^2.21.0",
		"@heroui/react": "^3.2.3",
		"@heroui/styles": "^3.2.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"i18next": "^26.3.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^17.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"@vitest/coverage-v8": "^4.1.10",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vitest": "^4.1.10"
	}
}
